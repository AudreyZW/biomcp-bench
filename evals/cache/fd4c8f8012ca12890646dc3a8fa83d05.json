OF SRI-9662 RESULTED\n  IN A FREE R-FACTOR OF 18.1%. SEVERAL LARGE PEAKS OF\n  POSITIVE DIFFERENCE DENSITY WERE LOCATED IN THE NADPH\n  BINDING SITE, THE LARGEST BEING 0.7 A AWAY FROM THE C7N\n  CARBON ATOM, AND WERE ASSIGNED TO DMSO AT PARTIAL\n  OCCUPANCY.  HOH 607, 608, AND 609 ARE LOCATED IN THE\nNDP BINDING SITE, ARE PRESENT ONLY WHEN NDP IS NOT, AND ARE THUS INCLUDED IN\nALTERNATE CONFORMATION B, ALONG WITH THE DMSO MOLECULE (NDP IS MODELED AS ALTERNATE CONFORMATION A).", "ls_R_factor_R_free": 0.1807, "ls_R_factor_R_work": 0.1302, "ls_d_res_high": 1.05, "ls_d_res_low": 20.0, "ls_number_parameters": 17886, "ls_number_reflns_R_free": 4325, "ls_number_reflns_all": 86271, "ls_number_reflns_obs": 86271, "ls_number_restraints": 21912, "ls_percent_reflns_R_free": 5.0, "ls_percent_reflns_obs": 97.5, "pdbx_R_Free_selection_details": "5% OF THE REFLECTIONS WERE RANDOMLY SELECTED FOR THE TEST SET.", "pdbx_diffrn_id": ["1"], "pdbx_ls_cross_valid_method": "THROUGHOUT", "pdbx_ls_sigma_F": 0.0, "pdbx_ls_sigma_I": 0.0, "pdbx_method_to_determine_struct": "MOLECULAR REPLACEMENT", "pdbx_refine_id": "X-RAY DIFFRACTION", "pdbx_starting_model": "UNPUBLISHED HUMAN DHFR STRUCTURE.", "pdbx_stereochemistry_target_values": "ENGH & HUBER", "solvent_model_details": "MOEWS & KRETSINGER, J.MOL.BIOL.91(1973)201-228"}], "refine_analyze": [{"number_disordered_residues": 17.0, "occupancy_sum_hydrogen": 1412.08, "occupancy_sum_non_hydrogen": 1843.16, "pdbx_refine_id": "X-RAY DIFFRACTION"}], "refine_hist": [{"cycle_id": "LAST", "d_res_high": 1.05, "d_res_low": 20.0, "number_atoms_solvent": 338, "number_atoms_total": 1948, "pdbx_number_atoms_ligand": 82, "pdbx_number_atoms_nucleic_acid": 0, "pdbx_number_atoms_protein": 1528, "pdbx_refine_id": "X-RAY DIFFRACTION"}], "refine_ls_restr": [{"dev_ideal": 0.017, "pdbx_refine_id": "X-RAY DIFFRACTION", "type": "s_bond_d"}, {"dev_ideal": 0.035, "pdbx_refine_id": "X-RAY DIFFRACTION", "type": "s_angle_d"}, {"dev_ideal": 0.0, "pdbx_refine_id": "X-RAY DIFFRACTI